# Copy to .env and fill in. Docker Compose reads .env automatically.
# Leave a key empty to skip that provider; the mock and Ollama need none.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Bearer token for the /admin API, used to create the first teams, users and
# keys. Generate one with: echo "pw-admin-$(openssl rand -hex 16)"
PITWALL_ADMIN_TOKEN=

# Set these to run the gateway outside Docker with keys, cost rows and
# budgets; leave them empty for dev mode.
PITWALL_DATABASE_URL=
PITWALL_REDIS_URL=
