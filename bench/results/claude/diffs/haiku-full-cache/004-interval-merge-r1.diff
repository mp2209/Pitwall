-		if n := len(out); n > 0 && iv.Start < out[n-1].End {
+	for _, iv := range sorted {
+		if n := len(out); n > 0 && iv.Start <= out[n-1].End {
 			if iv.End > out[n-1].End {
 				out[n-1].End = iv.End
 			}
