--- a/semver.go
+++ b/semver.go
@@ -4,7 +4,107 @@
 import "strings"
 
 // Compare returns -1, 0 or 1 as version a is lower than, equal to, or
-// higher than version b.
+// higher than version b. It follows the SemVer 2.0.0 precedence rules.
 func Compare(a, b string) int {
+	coreA, preA := split(a)
+	coreB, preB := split(b)
+
+	// Major, minor, patch: compare numerically.
+	partsA := strings.Split(coreA, ".")
+	partsB := strings.Split(coreB, ".")
+	for i := 0; i < len(partsA) || i < len(partsB); i++ {
+		if c := compareNumeric(part(partsA, i), part(partsB, i)); c != 0 {
+			return c
+		}
+	}
+
+	// A version without pre-release is higher than one with pre-release.
+	switch {
+	case preA == "" && preB == "":
+		return 0
+	case preA == "":
+		return 1
+	case preB == "":
+		return -1
+	}
+
+	idsA := strings.Split(preA, ".")
+	idsB := strings.Split(preB, ".")
+	for i := 0; i < len(idsA) && i < len(idsB); i++ {
+		if c := compareIdentifier(idsA[i], idsB[i]); c != 0 {
+			return c
+		}
+	}
+	// All shared identifiers equal: the shorter list comes first.
+	return compareInt(len(idsA), len(idsB))
+}
+
+// split strips a leading "v" and build metadata, then separates the
+// core version from the pre-release.
+func split(v string) (core, pre string) {
+	v = strings.TrimPrefix(v, "v")
+	if i := strings.IndexByte(v, '+'); i >= 0 {
+		v = v[:i]
+	}
+	if i := strings.IndexByte(v, '-'); i >= 0 {
+		return v[:i], v[i+1:]
+	}
+	return v, ""
+}
+
+// part returns parts[i], or "0" when the core version has fewer fields.
+func part(parts []string, i int) string {
+	if i < len(parts) {
+		return parts[i]
+	}
+	return "0"
+}
+
+// compareIdentifier compares one pre-release identifier: numeric
+// identifiers numerically, text identifiers lexically, and numeric
+// identifiers before text identifiers.
+func compareIdentifier(a, b string) int {
+	numA, numB := isNumeric(a), isNumeric(b)
+	switch {
+	case numA && numB:
+		return compareNumeric(a, b)
+	case numA:
+		return -1
+	case numB:
+		return 1
+	}
 	return strings.Compare(a, b)
 }
+
+// compareNumeric compares two non-negative decimal strings without
+// converting them to integers, so arbitrarily large values work.
+func compareNumeric(a, b string) int {
+	a = strings.TrimLeft(a, "0")
+	b = strings.TrimLeft(b, "0")
+	if c := compareInt(len(a), len(b)); c != 0 {
+		return c
+	}
+	return strings.Compare(a, b)
+}
+
+func isNumeric(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func compareInt(a, b int) int {
+	switch {
+	case a < b:
+		return -1
+	case a > b:
+		return 1
+	}
+	return 0
+}
