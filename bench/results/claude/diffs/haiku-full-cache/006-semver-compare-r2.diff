--- a/semver.go
+++ b/semver.go
@@ -5,6 +5,112 @@
 
 // Compare returns -1, 0 or 1 as version a is lower than, equal to, or
 // higher than version b.
+//
+// Ordering follows the SemVer spec: a leading "v" and build metadata
+// ("+...") are ignored, major/minor/patch compare numerically, and a
+// pre-release sorts before the release it belongs to.
 func Compare(a, b string) int {
+	ca, pa := split(a)
+	cb, pb := split(b)
+
+	for i := 0; i < 3; i++ {
+		if c := compareNumeric(ca[i], cb[i]); c != 0 {
+			return c
+		}
+	}
+
+	// A version without pre-release is higher than one with it.
+	switch {
+	case pa == "" && pb == "":
+		return 0
+	case pa == "":
+		return 1
+	case pb == "":
+		return -1
+	}
+	return comparePre(pa, pb)
+}
+
+// split returns the three numeric core parts and the pre-release string
+// (empty if none) of a version.
+func split(v string) ([3]string, string) {
+	v = strings.TrimPrefix(v, "v")
+	if i := strings.IndexByte(v, '+'); i >= 0 {
+		v = v[:i]
+	}
+	pre := ""
+	if i := strings.IndexByte(v, '-'); i >= 0 {
+		v, pre = v[:i], v[i+1:]
+	}
+	var core [3]string
+	parts := strings.SplitN(v, ".", 3)
+	for i := range core {
+		core[i] = "0"
+		if i < len(parts) && parts[i] != "" {
+			core[i] = parts[i]
+		}
+	}
+	return core, pre
+}
+
+// compareNumeric compares two non-negative integer strings without
+// converting them, so arbitrarily large values are handled.
+func compareNumeric(a, b string) int {
+	a = strings.TrimLeft(a, "0")
+	b = strings.TrimLeft(b, "0")
+	if len(a) != len(b) {
+		if len(a) < len(b) {
+			return -1
+		}
+		return 1
+	}
 	return strings.Compare(a, b)
 }
+
+// isNumeric reports whether s is a non-empty string of ASCII digits.
+func isNumeric(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// comparePre compares two non-empty pre-release strings identifier by
+// identifier.
+func comparePre(a, b string) int {
+	ia := strings.Split(a, ".")
+	ib := strings.Split(b, ".")
+	for i := 0; i < len(ia) && i < len(ib); i++ {
+		x, y := ia[i], ib[i]
+		xNum := isNumeric(x)
+		yNum := isNumeric(y)
+		var c int
+		switch {
+		case xNum && yNum:
+			c = compareNumeric(x, y)
+		case xNum:
+			// Numeric identifiers have lower precedence than alphanumeric.
+			c = -1
+		case yNum:
+			c = 1
+		default:
+			c = strings.Compare(x, y)
+		}
+		if c != 0 {
+			return c
+		}
+	}
+	// All shared identifiers are equal: the shorter list comes first.
+	switch {
+	case len(ia) < len(ib):
+		return -1
+	case len(ia) > len(ib):
+		return 1
+	}
+	return 0
+}
