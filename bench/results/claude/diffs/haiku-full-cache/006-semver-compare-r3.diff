--- a/semver.go
+++ b/semver.go
@@ -4,7 +4,103 @@
 import "strings"
 
 // Compare returns -1, 0 or 1 as version a is lower than, equal to, or
-// higher than version b.
+// higher than version b. Versions follow the SemVer 2.0 precedence rules.
 func Compare(a, b string) int {
+	coreA, preA := split(a)
+	coreB, preB := split(b)
+
+	for i := 0; i < 3; i++ {
+		if c := compareNumeric(part(coreA, i), part(coreB, i)); c != 0 {
+			return c
+		}
+	}
+
+	// A version without pre-release identifiers is higher than one with them.
+	switch {
+	case preA == "" && preB == "":
+		return 0
+	case preA == "":
+		return 1
+	case preB == "":
+		return -1
+	}
+	return comparePre(preA, preB)
+}
+
+// split removes a leading "v" and any build metadata, and separates the
+// core version from the pre-release part.
+func split(v string) (core, pre string) {
+	v = strings.TrimPrefix(v, "v")
+	if i := strings.IndexByte(v, '+'); i >= 0 {
+		v = v[:i]
+	}
+	if i := strings.IndexByte(v, '-'); i >= 0 {
+		return v[:i], v[i+1:]
+	}
+	return v, ""
+}
+
+// part returns the i-th dot-separated component of core, or "0" if absent.
+func part(core string, i int) string {
+	fields := strings.Split(core, ".")
+	if i < len(fields) {
+		return fields[i]
+	}
+	return "0"
+}
+
+// compareNumeric compares two decimal numbers without overflowing.
+func compareNumeric(a, b string) int {
+	a = strings.TrimLeft(a, "0")
+	b = strings.TrimLeft(b, "0")
+	if len(a) != len(b) {
+		if len(a) < len(b) {
+			return -1
+		}
+		return 1
+	}
 	return strings.Compare(a, b)
 }
+
+func isNumeric(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// comparePre compares dot-separated pre-release identifiers.
+func comparePre(a, b string) int {
+	ai := strings.Split(a, ".")
+	bi := strings.Split(b, ".")
+	for i := 0; i < len(ai) && i < len(bi); i++ {
+		x, y := ai[i], bi[i]
+		xn, yn := isNumeric(x), isNumeric(y)
+		switch {
+		case xn && yn:
+			if c := compareNumeric(x, y); c != 0 {
+				return c
+			}
+		case xn:
+			return -1 // numeric identifiers sort before alphanumeric ones
+		case yn:
+			return 1
+		default:
+			if c := strings.Compare(x, y); c != 0 {
+				return c
+			}
+		}
+	}
+	switch {
+	case len(ai) < len(bi):
+		return -1
+	case len(ai) > len(bi):
+		return 1
+	}
+	return 0
+}
