--- a/csvline.go
+++ b/csvline.go
@@ -1,9 +1,54 @@
 // Package csvline parses single CSV records.
 package csvline
 
-import "strings"
+import (
+	"errors"
+	"strings"
+)
+
+// ErrUnterminatedQuote is returned when a quoted field is never closed.
+var ErrUnterminatedQuote = errors.New("csvline: unterminated quoted field")
 
 // ParseLine splits one CSV record into fields.
+//
+// Fields may be wrapped in double quotes. Inside quotes, a comma is part of
+// the field and a pair of double quotes ("") stands for one double quote.
+// Empty fields are kept.
 func ParseLine(line string) ([]string, error) {
-	return strings.Split(line, ","), nil
+	var fields []string
+	var b strings.Builder
+	inQuotes := false
+	quoted := false // current field started with a quote
+	i := 0
+	for i < len(line) {
+		c := line[i]
+		switch {
+		case inQuotes:
+			if c == '"' {
+				if i+1 < len(line) && line[i+1] == '"' {
+					b.WriteByte('"')
+					i++
+				} else {
+					inQuotes = false
+				}
+			} else {
+				b.WriteByte(c)
+			}
+		case c == '"' && b.Len() == 0 && !quoted:
+			inQuotes = true
+			quoted = true
+		case c == ',':
+			fields = append(fields, b.String())
+			b.Reset()
+			quoted = false
+		default:
+			b.WriteByte(c)
+		}
+		i++
+	}
+	if inQuotes {
+		return nil, ErrUnterminatedQuote
+	}
+	fields = append(fields, b.String())
+	return fields, nil
 }
