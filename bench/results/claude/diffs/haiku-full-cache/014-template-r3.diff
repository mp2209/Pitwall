 // Package tmpl fills {{placeholders}} in text.
 package tmpl
 
-import "strings"
+import (
+	"fmt"
+	"strings"
+)
 
 // Render replaces each {{key}} in t with vars[key].
+// Values are inserted verbatim and never re-expanded. A missing key or an
+// unclosed "{{" is an error.
 func Render(t string, vars map[string]string) (string, error) {
-	for k, v := range vars {
-		t = strings.ReplaceAll(t, "{{"+k+"}}", v)
+	var b strings.Builder
+	for {
+		open := strings.Index(t, "{{")
+		if open < 0 {
+			b.WriteString(t)
+			return b.String(), nil
+		}
+		b.WriteString(t[:open])
+		rest := t[open+2:]
+		end := strings.Index(rest, "}}")
+		if end < 0 {
+			return "", fmt.Errorf("unclosed placeholder starting at %q", t[open:])
+		}
+		key := strings.TrimSpace(rest[:end])
+		v, ok := vars[key]
+		if !ok {
+			return "", fmt.Errorf("no value for placeholder %q", key)
+		}
+		b.WriteString(v)
+		t = rest[end+2:]
 	}
-	return t, nil
 }
