 // Package csvline parses single CSV records.
 package csvline
 
-import "strings"
+import (
+	"errors"
+	"strings"
+)
+
+// ErrUnterminatedQuote is returned when a quoted field is not closed.
+var ErrUnterminatedQuote = errors.New("csvline: unterminated quoted field")
 
 // ParseLine splits one CSV record into fields.
 func ParseLine(line string) ([]string, error) {
-	return strings.Split(line, ","), nil
+	var fields []string
+	var cur strings.Builder
+	inQuotes := false
+	atFieldStart := true
+
+	for i := 0; i < len(line); i++ {
+		ch := line[i]
+		if inQuotes {
+			if ch == '"' {
+				if i+1 < len(line) && line[i+1] == '"' {
+					cur.WriteByte('"')
+					i++
+				} else {
+					inQuotes = false
+				}
+			} else {
+				cur.WriteByte(ch)
+			}
+			continue
+		}
+		switch {
+		case ch == ',':
+			fields = append(fields, cur.String())
+			cur.Reset()
+			atFieldStart = true
+			continue
+		case ch == '"' && atFieldStart:
+			inQuotes = true
+		default:
+			cur.WriteByte(ch)
+		}
+		atFieldStart = false
+	}
+	if inQuotes {
+		return nil, ErrUnterminatedQuote
+	}
+	fields = append(fields, cur.String())
+	return fields, nil
 }
