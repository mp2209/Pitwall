 // Split divides totalCents among n people as evenly as possible.
+// The shares add up to totalCents exactly; the first people pay the extra cents.
 func Split(totalCents int64, n int) ([]int64, error) {
 	if n <= 0 {
 		return nil, errors.New("n must be positive")
 	}
-	share := float64(totalCents) / float64(n)
+	if totalCents < 0 {
+		return nil, errors.New("total must not be negative")
+	}
+	share := totalCents / int64(n)
+	rem := totalCents % int64(n)
 	out := make([]int64, n)
 	for i := range out {
-		out[i] = int64(share)
+		out[i] = share
+		if int64(i) < rem {
+			out[i]++
+		}
 	}
 	return out, nil
 }
 
