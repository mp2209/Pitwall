--- a/merge.go
+++ b/merge.go
@@ -1,11 +1,45 @@
 // Package config merges layered configuration.
 package config
 
-// Merge returns base with override applied on top.
+// Merge returns a new map with override applied on top of base.
+// Nested maps merge key by key, other values from override replace base
+// values, and a nil override value deletes the key. Neither input is
+// modified and the result shares no mutable maps or slices with them.
 func Merge(base, override map[string]any) map[string]any {
-	out := base
+	out := make(map[string]any, len(base)+len(override))
+	for k, v := range base {
+		out[k] = deepCopy(v)
+	}
 	for k, v := range override {
-		out[k] = v
+		if v == nil {
+			delete(out, k)
+			continue
+		}
+		if om, ok := v.(map[string]any); ok {
+			bm, _ := out[k].(map[string]any)
+			out[k] = Merge(bm, om)
+			continue
+		}
+		out[k] = deepCopy(v)
 	}
 	return out
 }
+
+func deepCopy(v any) any {
+	switch t := v.(type) {
+	case map[string]any:
+		m := make(map[string]any, len(t))
+		for k, e := range t {
+			m[k] = deepCopy(e)
+		}
+		return m
+	case []any:
+		s := make([]any, len(t))
+		for i, e := range t {
+			s[i] = deepCopy(e)
+		}
+		return s
+	default:
+		return v
+	}
+}
