--- a/semver.go
+++ b/semver.go
@@ -6,5 +6,96 @@
 // Compare returns -1, 0 or 1 as version a is lower than, equal to, or
 // higher than version b.
 func Compare(a, b string) int {
-	return strings.Compare(a, b)
+	amain, apre := split(a)
+	bmain, bpre := split(b)
+
+	am := strings.Split(amain, ".")
+	bm := strings.Split(bmain, ".")
+	for i := 0; i < 3; i++ {
+		if c := cmpNum(part(am, i), part(bm, i)); c != 0 {
+			return c
+		}
+	}
+
+	switch {
+	case apre == "" && bpre == "":
+		return 0
+	case apre == "":
+		return 1
+	case bpre == "":
+		return -1
+	}
+
+	ai := strings.Split(apre, ".")
+	bi := strings.Split(bpre, ".")
+	for i := 0; i < len(ai) && i < len(bi); i++ {
+		x, y := ai[i], bi[i]
+		xn, yn := isNum(x), isNum(y)
+		var c int
+		switch {
+		case xn && yn:
+			c = cmpNum(x, y)
+		case xn:
+			c = -1
+		case yn:
+			c = 1
+		default:
+			c = strings.Compare(x, y)
+		}
+		if c != 0 {
+			return c
+		}
+	}
+	switch {
+	case len(ai) < len(bi):
+		return -1
+	case len(ai) > len(bi):
+		return 1
+	}
+	return 0
 }
+
+// split strips a leading "v" and build metadata, and separates the
+// pre-release part from the main version.
+func split(v string) (string, string) {
+	v = strings.TrimPrefix(v, "v")
+	if i := strings.IndexByte(v, '+'); i >= 0 {
+		v = v[:i]
+	}
+	if i := strings.IndexByte(v, '-'); i >= 0 {
+		return v[:i], v[i+1:]
+	}
+	return v, ""
+}
+
+func part(p []string, i int) string {
+	if i < len(p) {
+		return p[i]
+	}
+	return "0"
+}
+
+func isNum(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// cmpNum compares two non-negative decimal strings numerically.
+func cmpNum(x, y string) int {
+	x = strings.TrimLeft(x, "0")
+	y = strings.TrimLeft(y, "0")
+	if len(x) != len(y) {
+		if len(x) < len(y) {
+			return -1
+		}
+		return 1
+	}
+	return strings.Compare(x, y)
+}
