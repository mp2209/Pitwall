-			}
-			total += time.Duration(num) * u
-			num = 0
+	i, n := 0, len(s)
+	parts := 0
+	for {
+		for i < n && isSpace(s[i]) {
+			i++
 		}
+		if i >= n {
+			break
+		}
+		start := i
+		for i < n && isNum(s[i]) {
+			i++
+		}
+		if start == i {
+			return 0, fmt.Errorf("expected number at %q", s[start:])
+		}
+		v, err := strconv.ParseFloat(s[start:i], 64)
