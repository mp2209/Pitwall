+			return 0, fmt.Errorf("unknown unit %q", s[ustart:i])
+		}
+		total += time.Duration(math.Round(v * float64(u)))
+		parts++
+	}
+	if parts == 0 {
+		return 0, fmt.Errorf("empty duration")
 	}
 	return total, nil
