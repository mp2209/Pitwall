--- a/semver.go
+++ b/semver.go
@@ -6,5 +6,98 @@
 // Compare returns -1, 0 or 1 as version a is lower than, equal to, or
 // higher than version b.
 func Compare(a, b string) int {
+	coreA, preA := split(a)
+	coreB, preB := split(b)
+
+	for i := 0; i < 3; i++ {
+		if c := cmpNum(coreA[i], coreB[i]); c != 0 {
+			return c
+		}
+	}
+
+	// A version without a pre-release comes after one with it.
+	if preA == nil && preB == nil {
+		return 0
+	}
+	if preA == nil {
+		return 1
+	}
+	if preB == nil {
+		return -1
+	}
+
+	for i := 0; i < len(preA) && i < len(preB); i++ {
+		x, y := preA[i], preB[i]
+		xn, yn := isNum(x), isNum(y)
+		switch {
+		case xn && yn:
+			if c := cmpNum(x, y); c != 0 {
+				return c
+			}
+		case xn:
+			return -1
+		case yn:
+			return 1
+		default:
+			if c := strings.Compare(x, y); c != 0 {
+				return c
+			}
+		}
+	}
+	switch {
+	case len(preA) < len(preB):
+		return -1
+	case len(preA) > len(preB):
+		return 1
+	}
+	return 0
+}
+
+// split parses a version into its three core parts and pre-release
+// identifiers (nil if there is no pre-release).
+func split(v string) ([3]string, []string) {
+	v = strings.TrimPrefix(v, "v")
+	if i := strings.IndexByte(v, '+'); i >= 0 {
+		v = v[:i]
+	}
+	var pre []string
+	if i := strings.IndexByte(v, '-'); i >= 0 {
+		pre = strings.Split(v[i+1:], ".")
+		v = v[:i]
+	}
+	var core [3]string
+	parts := strings.Split(v, ".")
+	for i := 0; i < 3; i++ {
+		if i < len(parts) {
+			core[i] = parts[i]
+		} else {
+			core[i] = "0"
+		}
+	}
+	return core, pre
+}
+
+func isNum(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// cmpNum compares two decimal digit strings numerically without overflow.
+func cmpNum(a, b string) int {
+	a = strings.TrimLeft(a, "0")
+	b = strings.TrimLeft(b, "0")
+	if len(a) != len(b) {
+		if len(a) < len(b) {
+			return -1
+		}
+		return 1
+	}
 	return strings.Compare(a, b)
 }
