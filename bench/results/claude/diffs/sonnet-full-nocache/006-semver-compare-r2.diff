--- a/semver.go
+++ b/semver.go
@@ -6,5 +6,96 @@
 // Compare returns -1, 0 or 1 as version a is lower than, equal to, or
 // higher than version b.
 func Compare(a, b string) int {
+	amain, apre, ahasPre := split(a)
+	bmain, bpre, bhasPre := split(b)
+
+	am := strings.Split(amain, ".")
+	bm := strings.Split(bmain, ".")
+	for i := 0; i < 3; i++ {
+		if c := cmpNum(part(am, i), part(bm, i)); c != 0 {
+			return c
+		}
+	}
+
+	switch {
+	case !ahasPre && !bhasPre:
+		return 0
+	case ahasPre && !bhasPre:
+		return -1
+	case !ahasPre && bhasPre:
+		return 1
+	}
+
+	ai := strings.Split(apre, ".")
+	bi := strings.Split(bpre, ".")
+	for i := 0; i < len(ai) && i < len(bi); i++ {
+		if c := cmpIdent(ai[i], bi[i]); c != 0 {
+			return c
+		}
+	}
+	switch {
+	case len(ai) < len(bi):
+		return -1
+	case len(ai) > len(bi):
+		return 1
+	}
+	return 0
+}
+
+// split removes a leading "v" and build metadata, and separates the
+// pre-release part from the main version.
+func split(v string) (main, pre string, hasPre bool) {
+	v = strings.TrimPrefix(v, "v")
+	if i := strings.IndexByte(v, '+'); i >= 0 {
+		v = v[:i]
+	}
+	if i := strings.IndexByte(v, '-'); i >= 0 {
+		return v[:i], v[i+1:], true
+	}
+	return v, "", false
+}
+
+func part(p []string, i int) string {
+	if i < len(p) {
+		return p[i]
+	}
+	return "0"
+}
+
+func isNum(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// cmpNum compares two digit strings numerically without overflow.
+func cmpNum(a, b string) int {
+	a = strings.TrimLeft(a, "0")
+	b = strings.TrimLeft(b, "0")
+	if len(a) != len(b) {
+		if len(a) < len(b) {
+			return -1
+		}
+		return 1
+	}
 	return strings.Compare(a, b)
 }
+
+func cmpIdent(a, b string) int {
+	an, bn := isNum(a), isNum(b)
+	switch {
+	case an && bn:
+		return cmpNum(a, b)
+	case an:
+		return -1
+	case bn:
+		return 1
+	}
+	return strings.Compare(a, b)
+}
