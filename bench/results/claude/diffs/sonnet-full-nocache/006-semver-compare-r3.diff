--- a/semver.go
+++ b/semver.go
@@ -6,5 +6,94 @@
 // Compare returns -1, 0 or 1 as version a is lower than, equal to, or
 // higher than version b.
 func Compare(a, b string) int {
+	coreA, preA := split(a)
+	coreB, preB := split(b)
+
+	for i := 0; i < 3; i++ {
+		if c := cmpNum(coreA[i], coreB[i]); c != 0 {
+			return c
+		}
+	}
+
+	switch {
+	case preA == nil && preB == nil:
+		return 0
+	case preA == nil:
+		return 1
+	case preB == nil:
+		return -1
+	}
+
+	for i := 0; i < len(preA) && i < len(preB); i++ {
+		x, y := preA[i], preB[i]
+		xn, yn := isNum(x), isNum(y)
+		var c int
+		switch {
+		case xn && yn:
+			c = cmpNum(x, y)
+		case xn:
+			c = -1
+		case yn:
+			c = 1
+		default:
+			c = strings.Compare(x, y)
+		}
+		if c != 0 {
+			return c
+		}
+	}
+	switch {
+	case len(preA) < len(preB):
+		return -1
+	case len(preA) > len(preB):
+		return 1
+	}
+	return 0
+}
+
+// split parses a version into its three core numbers and pre-release
+// identifiers (nil if there is no pre-release).
+func split(v string) ([3]string, []string) {
+	v = strings.TrimPrefix(v, "v")
+	if i := strings.IndexByte(v, '+'); i >= 0 {
+		v = v[:i]
+	}
+	var pre []string
+	if i := strings.IndexByte(v, '-'); i >= 0 {
+		pre = strings.Split(v[i+1:], ".")
+		v = v[:i]
+	}
+	var core [3]string
+	parts := strings.Split(v, ".")
+	for i := 0; i < 3; i++ {
+		if i < len(parts) {
+			core[i] = parts[i]
+		}
+	}
+	return core, pre
+}
+
+func isNum(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// cmpNum compares two decimal digit strings numerically without overflow.
+func cmpNum(a, b string) int {
+	a = strings.TrimLeft(a, "0")
+	b = strings.TrimLeft(b, "0")
+	if len(a) != len(b) {
+		if len(a) < len(b) {
+			return -1
+		}
+		return 1
+	}
 	return strings.Compare(a, b)
 }
