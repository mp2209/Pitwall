--- a/backoff.go
+++ b/backoff.go
@@ -3,7 +3,27 @@
 
 import "time"
 
-// Delay returns how long to wait before retry number attempt.
+// Delay returns how long to wait before retry number attempt (from 0):
+// base doubled once per attempt, capped at max. Negative attempts count as 0.
 func Delay(attempt int, base, max time.Duration) time.Duration {
-	return base * time.Duration(1<<attempt)
+	if attempt < 0 {
+		attempt = 0
+	}
+	if base >= max {
+		return max
+	}
+	if base <= 0 {
+		return base
+	}
+	d := base
+	for i := 0; i < attempt; i++ {
+		if d > max/2 {
+			return max
+		}
+		d *= 2
+	}
+	if d > max {
+		return max
+	}
+	return d
 }
