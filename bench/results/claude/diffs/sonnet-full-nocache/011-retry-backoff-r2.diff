--- a/backoff.go
+++ b/backoff.go
@@ -3,7 +3,24 @@
 
 import "time"
 
-// Delay returns how long to wait before retry number attempt.
+// Delay returns how long to wait before retry number attempt (counting from 0):
+// base doubled once per attempt, capped at max. A negative attempt counts as 0.
 func Delay(attempt int, base, max time.Duration) time.Duration {
-	return base * time.Duration(1<<attempt)
+	if base >= max {
+		return max
+	}
+	d := base
+	for i := 0; i < attempt; i++ {
+		if d > max/2 {
+			return max
+		}
+		d *= 2
+		if d <= 0 { // base <= 0: doubling never grows
+			return d
+		}
+	}
+	if d > max {
+		return max
+	}
+	return d
 }
