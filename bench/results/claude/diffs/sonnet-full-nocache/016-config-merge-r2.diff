 // Package config merges layered configuration.
 package config
 
-// Merge returns base with override applied on top.
+// Merge returns base with override applied on top. Neither input is modified
+// and the result shares no maps or slices with them.
 func Merge(base, override map[string]any) map[string]any {
-	out := base
+	out := make(map[string]any, len(base))
+	for k, v := range base {
+		out[k] = clone(v)
+	}
 	for k, v := range override {
-		out[k] = v
+		if v == nil {
+			delete(out, k)
+			continue
+		}
+		if om, ok := v.(map[string]any); ok {
+			if bm, ok := out[k].(map[string]any); ok {
+				out[k] = Merge(bm, om)
+			} else {
+				out[k] = Merge(nil, om)
+			}
+			continue
+		}
+		out[k] = clone(v)
 	}
 	return out
 }
+
+// clone deep-copies maps and slices.
+func clone(v any) any {
+	switch t := v.(type) {
+	case map[string]any:
+		m := make(map[string]any, len(t))
+		for k, e := range t {
+			m[k] = clone(e)
+		}
+		return m
+	case []any:
+		s := make([]any, len(t))
+		for i, e := range t {
+			s[i] = clone(e)
+		}
+		return s
+	}
+	return v
+}
