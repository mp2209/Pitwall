+// ParseLine splits one CSV record into fields. Fields may be wrapped in
+// double quotes; inside quotes a comma is literal and "" is one quote.
 func ParseLine(line string) ([]string, error) {
-	return strings.Split(line, ","), nil
+	var fields []string
+	var cur strings.Builder
+	inQuotes := false
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		if inQuotes {
+			if c == '"' {
+				if i+1 < len(line) && line[i+1] == '"' {
+					cur.WriteByte('"')
+					i++
+				} else {
+					inQuotes = false
+				}
+			} else {
+				cur.WriteByte(c)
+			}
+			continue
+		}
+		switch c {
+		case '"':
+			inQuotes = true
+		case ',':
+			fields = append(fields, cur.String())
+			cur.Reset()
+		default:
+			cur.WriteByte(c)
+		}
+	}
+	if inQuotes {
+		return nil, errors.New("csvline: unterminated quote")
+	}
+	fields = append(fields, cur.String())
+	return fields, nil
 }
