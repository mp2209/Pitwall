 import "time"
 
 // Delay returns how long to wait before retry number attempt.
+// The base delay doubles per attempt (a negative attempt counts as 0)
+// and is never more than max.
 func Delay(attempt int, base, max time.Duration) time.Duration {
-	return base * time.Duration(1<<attempt)
+	if attempt < 0 {
+		attempt = 0
+	}
+	if base >= max {
+		return max
+	}
+	d := base
+	for i := 0; i < attempt; i++ {
+		if d > max/2 {
+			return max
+		}
+		d *= 2
+	}
+	return d
 }
