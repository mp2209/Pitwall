 import "time"
 
 // Delay returns how long to wait before retry number attempt.
+// The base delay doubles with each attempt, capped at max.
+// A negative attempt is treated as 0.
 func Delay(attempt int, base, max time.Duration) time.Duration {
-	return base * time.Duration(1<<attempt)
+	if attempt < 0 {
+		attempt = 0
+	}
+	if base >= max {
+		return max
+	}
+	d := base
+	for i := 0; i < attempt; i++ {
+		if d > max/2 {
+			return max
+		}
+		d *= 2
+		if d <= 0 {
+			// base <= 0: doubling never grows
+			return base
+		}
+	}
+	if d > max {
+		return max
+	}
+	return d
 }
