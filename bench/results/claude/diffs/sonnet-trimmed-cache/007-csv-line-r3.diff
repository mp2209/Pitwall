 // Package csvline parses single CSV records.
 package csvline
 
-import "strings"
+import (
+	"errors"
+	"strings"
+)
 
 // ParseLine splits one CSV record into fields.
+// Fields may be wrapped in double quotes; inside quotes a comma is literal
+// and "" stands for a single double quote. An unterminated quote is an error.
 func ParseLine(line string) ([]string, error) {
-	return strings.Split(line, ","), nil
+	var fields []string
+	var cur strings.Builder
+	inQuotes := false
+	atStart := true // at the start of a field
+
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		if inQuotes {
+			if c == '"' {
+				if i+1 < len(line) && line[i+1] == '"' {
+					cur.WriteByte('"')
+					i++
+				} else {
+					inQuotes = false
+				}
+			} else {
+				cur.WriteByte(c)
+			}
+			continue
+		}
+		switch {
+		case c == ',':
+			fields = append(fields, cur.String())
+			cur.Reset()
+			atStart = true
+			continue
+		case c == '"' && atStart:
+			inQuotes = true
+		default:
+			cur.WriteByte(c)
+		}
+		atStart = false
+	}
+	if inQuotes {
+		return nil, errors.New("csvline: unterminated quote")
+	}
+	fields = append(fields, cur.String())
+	return fields, nil
 }
