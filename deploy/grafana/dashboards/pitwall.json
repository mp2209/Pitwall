    {
      "id": 2,
      "type": "stat",
      "title": "Tasks",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pitwall-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pitwall-postgres"
          },
          "rawSql": "SELECT count(*) AS tasks FROM tasks WHERE $__timeFilter(started_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
