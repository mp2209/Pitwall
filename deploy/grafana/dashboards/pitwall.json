        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Solved",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pitwall-postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pitwall-postgres"
          },
          "rawSql": "SELECT count(*) FILTER (WHERE outcome = 'solved') AS solved FROM tasks WHERE $__timeFilter(started_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
