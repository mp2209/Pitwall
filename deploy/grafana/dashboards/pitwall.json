{
  "uid": "pitwall-tasks",
  "title": "Pitwall: tasks and gateway",
  "tags": [
    "pitwall"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "task",
        "label": "Task",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "pitwall-postgres"
        },
        "query": "SELECT coalesce(external_id, id) || ' \u00b7 ' || to_char(started_at, 'MM-DD HH24:MI') AS __text, id AS __value FROM tasks ORDER BY started_at DESC LIMIT 100",
        "definition": "recent tasks",
        "refresh": 2,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
