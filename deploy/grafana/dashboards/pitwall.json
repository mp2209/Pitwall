      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pitwall-prometheus"
          },
          "expr": "(sum by (model) (rate(pitwall_cost_without_cache_usd_total[$__rate_interval])) - sum by (model) (rate(pitwall_cost_usd_total[$__rate_interval]))) * 3600",
          "legendFormat": "{{model}}",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
