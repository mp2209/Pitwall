    {
      "id": 12,
      "type": "timeseries",
      "title": "Prompt-cache savings per hour",
      "description": "Cost without caching minus actual cost. Negative when cache writes outweigh reads.",
      "datasource": {
        "type": "prometheus",
        "uid": "pitwall-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
